    <!-- Top -->
    <path android:fillColor="#D32F2F"
          android:pathData="M51,19 L57,19 L57,25 L51,25 Z"/>
    <!-- Bottom -->
    <path android:fillColor="#D32F2F"
          android:pathData="M51,83 L57,83 L57,89 L51,89 Z"/>
    <!-- Left -->
    <path android:fillColor="#D32F2F"
          android:pathData="M19,51 L25,51 L25,57 L19,57 Z"/>
