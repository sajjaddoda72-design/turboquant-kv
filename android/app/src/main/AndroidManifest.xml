<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for Hugging Face model download (HTTPS) -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Declare now; request at runtime before showing a download notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:name=".TurboQuantApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.TurboQuantAI"
        android:largeHeap="true"
        android:extractNativeLibs="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:hardwareAccelerated="true">

        <!--
            largeHeap: Gemma 2B Q4_K_M requires ~1.5 GB of active memory.
            Without this flag the default heap cap causes an OOM before the
            model fully loads on most mid-range devices.

            extractNativeLibs: libturboquant.so + llama.cpp/ggml shared
            objects must be extracted to the filesystem so dlopen() can
            load them at runtime (required for JNI).
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard">

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

    </application>

</manifest>
